# Local Docker Compose defaults
BASE_DOMAIN=localhost
PUBLIC_PROTOCOL=http
ADMIN_USER=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=replace-this-secret-before-running-in-production
MAX_UPLOAD_MB=100

# For a public deployment, use your real domain, HTTPS, a password with at
# least 12 characters, and a random SESSION_SECRET with at least 32 characters.
